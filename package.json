{
  "name": "wellbeing-challenge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "setup": "node scripts/setup.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:migrate": "supabase migration up --local",
    "db:new": "node scripts/db-new-migration.mjs",
    "db:test": "node scripts/db-test.mjs",
    "db:prod:login": "supabase login",
    "db:prod:status": "node scripts/db-prod.mjs status",
    "db:prod:migrate": "node scripts/db-prod.mjs migrate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest": "^30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "picomatch": "^4.0.7",
    "prettier": "3.6.2",
    "supabase": "2.116.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
