# Template for .env.local. You normally don't need to copy this by hand:
# `npm run setup` creates .env.local with the values of your local Supabase stack.
# Local development must point at the local stack, never at production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_from_npx_supabase_status
